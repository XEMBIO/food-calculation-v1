<Page x:Class="food_calculation.IngredientPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:food_calculation"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="IngredientPage">

    <Grid>

        <Grid.Background>
            <LinearGradientBrush>
                <GradientStop Color="#006ba9" Offset="0"/>
                <GradientStop Color="#001a4a" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label
            Grid.Row="0"
            Grid.Column="1"
            Content="Ingredients"
            Margin="20"
            VerticalContentAlignment="Center"
            HorizontalContentAlignment="Center"
            FontSize="35"
            FontWeight="Bold"
            x:Name="Title"
            Foreground="White"/>

        <Button
            Grid.Row="0"
            Grid.Column="2"
            Margin="20"
            Background="#ff0000"
            BorderThickness="4"
            Content="Zurück"
            FontSize="20"
            Click="BackButton"
            Foreground="White"
            x:Name="backButton">
            <Button.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <ThicknessAnimation
                                Storyboard.TargetName="backButton"
                                Storyboard.TargetProperty="Margin"
                                To="15"
                                Duration="0:0:0.2"/>
                            <DoubleAnimation
                                Storyboard.TargetName="backButton"
                                Storyboard.TargetProperty="FontSize"
                                By="2"
                                Duration="0:0:0.2"
                                FillBehavior="HoldEnd"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <ThicknessAnimation
                                Storyboard.TargetName="backButton"
                                Storyboard.TargetProperty="Margin"
                                To="20"
                                Duration="0:0:0.2"/>
                            <DoubleAnimation
                                Storyboard.TargetName="backButton"
                                Storyboard.TargetProperty="FontSize"
                                By="-2"
                                Duration="0:0:0.2"
                                FillBehavior="Stop"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Button.Triggers>
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border
                        Background="#a1000000"
                        CornerRadius="25"
                        >
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>

        </Button>


        <Border
            Grid.Row="0"
            Grid.Column="0"
            CornerRadius="20"
            Background="#a1000000"
            Margin="30,60,3,0"
            >

            <TextBox

                Background="Transparent"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                PreviewTextInput="NumberTextBox"
                Foreground="White"
                BorderThickness="0"
                Margin="5"
                x:Name="AmountPeople"/>

        </Border>


        <Button
            Grid.Row="0"
            Grid.Column="1"
            Width="60"
            Margin="2,60,0,0"
            HorizontalAlignment="Left"
            Click="RefreshIngredients"
            x:Name="AddButton">
            <Button.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <ThicknessAnimation
                            Storyboard.TargetName="AddButton"
                            Storyboard.TargetProperty="Margin"
                            To="0,58,-2,-2"
                            Duration="0:0:0.2"/>
                            <DoubleAnimation
                            Storyboard.TargetName="AddButton"
                            Storyboard.TargetProperty="Width"
                            To="65"
                            Duration="0:0:0.2"/>
                            <DoubleAnimation
                            Storyboard.TargetName="AddButton"
                            Storyboard.TargetProperty="FontSize"
                            By="2"
                            Duration="0:0:0.2"
                            FillBehavior="HoldEnd"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <ThicknessAnimation
                            Storyboard.TargetName="AddButton"
                            Storyboard.TargetProperty="Margin"
                            To="2,60,0,0"
                            Duration="0:0:0.2"/>
                            <DoubleAnimation
                            Storyboard.TargetName="AddButton"
                            Storyboard.TargetProperty="Width"
                            To="60"
                            Duration="0:0:0.2"/>
                            <DoubleAnimation
                            Storyboard.TargetName="AddButton"
                            Storyboard.TargetProperty="FontSize"
                            By="-2"
                            Duration="0:0:0.2"
                            FillBehavior="Stop"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Button.Triggers>
            <Button.Template>

                <ControlTemplate TargetType="Button">

                    <Border
                        Background="#a1000000"
                        CornerRadius="20">

                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                    </Border>
                    
                </ControlTemplate>
                
            </Button.Template>
            
        </Button>


        <Border
            Grid.Row="1"
            Grid.RowSpan="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            CornerRadius="25"
            Background="#a1000000"
            Margin="30">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                
                <StackPanel 
                    Margin="7"
                    x:Name="IngredientsPanel">
                    
                </StackPanel>

            </ScrollViewer>

        </Border>

        <Border
            Grid.Row="1"
            Grid.RowSpan="2"
            Grid.Column="1"
            Margin="180,30,30,30"
            Background="Transparent">

            <ScrollViewer 
                Margin="7"
                VerticalScrollBarVisibility="Auto"
                x:Name="IngredientMenu">
                <StackPanel x:Name="IngredientAmountPanel"></StackPanel>
            </ScrollViewer>

        </Border>
        
        

        <Button
            Grid.Row="1"
            Grid.Column="2"
            Margin="15,20"
            Background="#00ff00"
            Content="Bestätigen"
            FontSize="20"
            Click="DoneButton"
            Foreground="White"
            x:Name="doneButton">
            <Button.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <ThicknessAnimation
                                Storyboard.TargetName="doneButton"
                                Storyboard.TargetProperty="Margin"
                                To="15"
                                Duration="0:0:0.2"/>
                            <DoubleAnimation
                                Storyboard.TargetName="doneButton"
                                Storyboard.TargetProperty="FontSize"
                                By="2"
                                Duration="0:0:0.2"
                                FillBehavior="HoldEnd"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <ThicknessAnimation
                                Storyboard.TargetName="doneButton"
                                Storyboard.TargetProperty="Margin"
                                To="20"
                                Duration="0:0:0.2"/>
                            <DoubleAnimation
                                Storyboard.TargetName="doneButton"
                                Storyboard.TargetProperty="FontSize"
                                By="-2"
                                Duration="0:0:0.2"
                                FillBehavior="Stop"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Button.Triggers>
            <Button.Template>

                <ControlTemplate TargetType="Button">

                    <Border Background="#a1000000" CornerRadius="25">

                        <ContentPresenter 
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                    </Border>

                </ControlTemplate>
                
            </Button.Template>

        </Button>

    </Grid>
</Page>
